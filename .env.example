# Copy to .env (git-ignored). Placeholders only - never commit real values.
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://widgets:widgets@localhost:5432/widgets
PUBLIC_BASE_URL=http://localhost:8000
ADMIN_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
SECRET_KEY=change-me-to-a-long-random-string
ALLOW_REGISTRATION=1
TOKEN_TTL_HOURS=168
# Set to 1 only when behind exactly one trusted reverse proxy that appends X-Forwarded-For
TRUST_PROXY=0
MAX_BODY_BYTES=16384
# Token buckets: capacity (burst) and refill per second
RL_IP_CAPACITY=10
RL_IP_REFILL=2
RL_WIDGET_CAPACITY=60
RL_WIDGET_REFILL=5
RL_AUTH_CAPACITY=5
RL_AUTH_REFILL=0.1
MIN_FILL_MS=1500
# Geo: "mock" (deterministic, for proofs) or "live" (ip-api.com then ipapi.co)
GEO_MODE=mock
GEO_TIMEOUT_SECONDS=1.5
# Email: leave SMTP_HOST empty to log to console; use localhost:1025 for Mailpit
SMTP_HOST=
SMTP_PORT=1025
MAIL_FROM=widgets@example.com
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_SECONDS=5
# Fault-injection endpoints (/_debug/*). DEV ONLY - never enable in production.
DEBUG_ENDPOINTS=1
